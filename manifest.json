{
	"manifest_version": 3,
	"name": "Transcript Extractor for Stream & YouTube",
	"version": "2.0",
	"description": "Extract and send transcripts from Microsoft Stream and captions from YouTube videos. One-click transcript/caption extraction for easy summarization via AI (LLMs) and Power Automate integration.",
	"permissions": [
		"clipboardWrite",
		"storage"
	],
	"host_permissions": [
		"https://*.microsoftstream.com/*",
		"https://*.sharepoint.com/*",
		"https://web.microsoftstream.com/*",
		"https://www.youtube.com/*",
		"https://youtube.com/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"icons": {
		"16": "icons/transcript-icon16.png",
		"32": "icons/transcript-icon32.png",
		"48": "icons/transcript-icon48.png",
		"128": "icons/transcript-icon128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"https://*.microsoftstream.com/*",
				"https://*.sharepoint.com/*",
				"https://web.microsoftstream.com/*"
			],
			"js": [
				"power-automate-util.js",
				"content.js"
			],
			"css": [
				"styles.css"
			],
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.youtube.com/*",
				"https://youtube.com/*"
			],
			"js": [
				"power-automate-util.js",
				"youtube-content.js"
			],
			"css": [
				"styles.css"
			],
			"run_at": "document_end"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"fetchOverride.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	]
}